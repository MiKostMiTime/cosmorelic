# Copy this file to .env and fill in your own key.
# Get a free key at https://console.groq.com/keys
# Never commit .env — it is listed in .gitignore.
GROQ_API_KEY=

# Optional. Overrides the default model id without touching code.
# Default is llama-3.1-8b-instant (fastest on Groq).
# If that model 404s (some keys have limited access), core.py
# automatically falls back in this order: qwen/qwen3.8-27b,
# openai/gpt-oss-120b, openai/gpt-oss-20b, allam-2-7b (constraint
# compliance measured per model, 2026-11).
# GROQ_MODEL=qwen/qwen3.8-27b
